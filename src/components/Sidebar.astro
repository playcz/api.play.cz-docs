---
import { navigation } from '../config/navigation.js';

const pathname = Astro.url.pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const isActive = (slug: string) => {
  const target = slug === '' ? '/' : `/${slug}`;
  return currentPath === target;
};
---

<aside class="sidebar">
  <div class="sidebar-search-wrapper">
    <div class="search-input-container">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input 
        type="search" 
        id="sidebar-search" 
        class="sidebar-search" 
        placeholder="Hledat v dokumentaci..." 
        aria-label="Hledat v dokumentaci"
        autocomplete="off"
      />
    </div>
  </div>

  <nav class="sidebar-nav scroller">
    {navigation.map((section) => (
      <div class="nav-section">
        <h3 class="nav-section-title">{section.title}</h3>
        <ul class="nav-section-list">
          {section.items.map((item) => (
            <li>
              <a 
                href={item.slug === '' ? '/' : `/${item.slug}`} 
                class={`nav-item ${isActive(item.slug) ? 'active' : ''}`}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-inline-end: 1px solid light-dark(var(--color-border-light), var(--color-border-dark));
    background-color: light-dark(var(--color-sidebar-bg-light), var(--color-sidebar-bg-dark));
  }

  .sidebar-search-wrapper {
    padding: 1.25rem 1.5rem 0.75rem;
  }

  .search-input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: light-dark(var(--color-text-muted-light), var(--color-text-muted-dark));
    pointer-events: none;
  }

  .sidebar-search {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.25rem;
    font-size: 0.875rem;
    background-color: light-dark(rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0.03));
    border: 1px solid light-dark(var(--color-border-light), var(--color-border-dark));
    border-radius: 8px;
    color: light-dark(var(--color-text-light), var(--color-text-dark));
    outline: none;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .sidebar-search:focus {
    border-color: light-dark(var(--color-primary-light), var(--color-primary-dark));
    background-color: light-dark(#fff, var(--color-bg-dark));
    box-shadow: 0 0 0 2px light-dark(rgba(0, 86, 179, 0.1), rgba(0, 229, 255, 0.15));
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 1.5rem 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: light-dark(#ccc, #444) transparent;
  }

  /* Custom scrollbar fallback if needed */
  @supports not (scrollbar-color: auto) {
    .sidebar-nav::-webkit-scrollbar {
      width: 6px;
    }
    .sidebar-nav::-webkit-scrollbar-thumb {
      background: light-dark(#ccc, #444);
      border-radius: 3px;
    }
  }

  .nav-section {
    margin-bottom: 1.5rem;
  }

  .nav-section:last-child {
    margin-bottom: 0;
  }

  .nav-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: light-dark(var(--color-text-muted-light), var(--color-text-muted-dark));
    margin-bottom: 0.5rem;
    padding-inline-start: 0.5rem;
  }

  .nav-section-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .nav-item {
    display: block;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: light-dark(var(--color-text-muted-light), var(--color-text-muted-dark));
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s, background-color 0.15s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-item:hover {
    color: light-dark(var(--color-text-light), var(--color-text-dark));
    background-color: light-dark(rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0.03));
  }

  .nav-item.active {
    color: light-dark(var(--color-primary-light), var(--color-primary-dark));
    background-color: light-dark(rgba(0, 86, 179, 0.08), rgba(0, 229, 255, 0.08));
    font-weight: 600;
  }
</style>

<script>
  function setupSearch() {
    const searchInput = document.getElementById('sidebar-search') as HTMLInputElement | null;
    if (!searchInput) return;

    const sections = document.querySelectorAll('.nav-section');

    searchInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const query = target.value.toLowerCase().trim();

      sections.forEach((section) => {
        let visibleCount = 0;
        const items = section.querySelectorAll('li');

        items.forEach((li) => {
          const a = li.querySelector('.nav-item');
          if (!a) return;

          const text = a.textContent?.toLowerCase() || '';
          const href = a.getAttribute('href')?.toLowerCase() || '';

          if (text.includes(query) || href.includes(query)) {
            li.style.display = 'block';
            visibleCount++;
          } else {
            li.style.display = 'none';
          }
        });

        const sectionHeading = section.querySelector('.nav-section-title') as HTMLElement | null;
        if (visibleCount > 0 || query === '') {
          (section as HTMLElement).style.display = 'block';
          if (sectionHeading) sectionHeading.style.display = 'block';
        } else {
          (section as HTMLElement).style.display = 'none';
          if (sectionHeading) sectionHeading.style.display = 'none';
        }
      });
    });
  }

  // Initial load
  setupSearch();

  // Handle View Transitions page navigation swaps
  document.addEventListener('astro:after-swap', setupSearch);
</script>
